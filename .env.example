# Copy to .env (never commit .env). Netlify: Site configuration > Environment variables.

# Browser (public; safe to expose, RLS protects data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Netlify Functions only (never prefix with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# iCal import links: optional here; the owner can set them in Settings instead (stored server-side only)
ICAL_AIRBNB_URL=
ICAL_BOOKING_COM_URL=

# Phase 3
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_MIRROR_SHEET_ID=
RESEND_API_KEY=
